---
import Base from '../layouts/Base.astro';

const symptoms = [
  { slug: 'veel-zuchten',   title: 'Veel zuchten',                   label: 'Ademhaling' },
  { slug: 'luchthonger',    title: 'Niet diep genoeg kunnen ademen', label: 'Ademhaling' },
  { slug: 'hartkloppingen', title: 'Hartkloppingen',                 label: 'Cardiovasculair' },
  { slug: 'gapen',          title: 'Overmatig gapen',                label: 'Ademhaling' },
];
---

<Base
  title="Chronische hyperventilatie: wetenschappelijk onderbouwde informatie"
  description="Je ademt, maar het voelt niet goed. Wetenschappelijk onderbouwde informatie over chronische hyperventilatie: oorzaken, diagnose en behandeling."
  canonical="/"
>

  <!-- Hero -->
  <section class="max-w-[1200px] mx-auto px-6 md:px-12 pt-16 md:pt-[72px] pb-16 relative">
    <div class="max-w-[580px]">
      <h1 class="font-serif text-hero font-light text-sand-700 mb-6">
        Je ademt, maar het voelt <em class="italic font-normal">niet goed</em>
      </h1>
      <p class="text-[17px] leading-[1.8] text-sand-600 mb-4">
        Je zucht diep maar de opluchting komt niet. Je gaapt de hele dag maar je bent niet moe. Je voelt dat je niet genoeg lucht krijgt, terwijl er niets mis is met je longen.
      </p>
      <p class="text-[17px] leading-[1.8] text-sand-600 mb-8">
        Misschien heb je al tientallen onderzoeken gehad. Alles normaal. En toch klopt er iets niet.
      </p>
      <a href="/symptomen/" class="inline-flex items-center gap-2 px-7 py-3 bg-sage-300 text-white text-sm font-medium rounded-lg no-underline hover:bg-sage-400 transition-colors">
        Herken je dit?
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="hidden lg:block absolute right-12 top-20 w-[340px] h-[340px] opacity-70">
      <div class="absolute w-[280px] h-[280px] rounded-full border border-sand-300 top-[30px] right-0 animate-drift"></div>
      <div class="absolute w-[180px] h-[180px] rounded-full border-[1.5px] border-sage-50 top-0 right-[100px] animate-drift [animation-direction:reverse]"></div>
      <div class="absolute w-[100px] h-[100px] rounded-full bg-sage-50 top-[140px] right-[40px] animate-breathe"></div>
    </div>
  </section>

  <!-- Symptomen -->
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pb-20">
    <div class="max-w-[720px] mx-auto">
      <p class="text-xs font-medium tracking-widest uppercase text-sand-400 mb-4">Veelvoorkomende signalen</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        {symptoms.map(s => (
          <li>
            <a href={`/symptomen/${s.slug}/`} class="group flex flex-col justify-between h-full bg-white hover:bg-sage-50 border border-sand-200 hover:border-sage-300 rounded-2xl p-6 transition-all no-underline min-h-[120px]">
              <div>
                <p class="text-xs font-medium tracking-widest uppercase text-sage-300 mb-2">{s.label}</p>
                <h2 class="font-serif text-[17px] font-normal text-sand-700 group-hover:text-sage-500 transition-colors leading-snug">{s.title}</h2>
              </div>
              <div class="flex justify-end mt-4">
                <div class="w-7 h-7 rounded-full bg-sage-100 group-hover:bg-sage-200 flex items-center justify-center transition-colors">
                  <svg class="w-3 h-3 text-sage-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/symptomen/" class="text-[13px] text-sage-300 hover:underline no-underline">Alle symptomen bekijken ↗</a>
    </div>
  </div>

  <!-- Wat is er aan de hand -->
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pb-20">
    <div class="max-w-[720px] mx-auto">
      <div class="bg-sage-50 rounded-2xl p-8 md:p-10 relative overflow-hidden reveal">
        <div class="absolute -right-10 -top-10 w-[200px] h-[200px] rounded-full bg-sage-300/[0.08] animate-breathe"></div>
        <p class="text-xs font-medium tracking-widest uppercase text-sage-300 mb-4 relative z-10">Wat is er aan de hand?</p>
        <p class="font-serif text-[20px] leading-[1.7] text-sage-500 mb-6 relative z-10">
          Dit heet <strong>chronische hyperventilatie</strong>. Niet de acute aanval die je misschien kent. Dit is subtieler en hardnekkiger.
        </p>
        <p class="text-[15px] leading-[1.8] text-sand-600 mb-4 relative z-10">
          Bij chronische hyperventilatie adem je de hele dag net iets te veel. Niet zichtbaar, niet dramatisch, maar genoeg om CO₂ in je bloed te laag te houden. Dat verstoort tientallen processen in je lichaam, van je spijsvertering tot je concentratie.
        </p>
        <p class="text-[15px] leading-[1.8] text-sand-600 mb-8 relative z-10">
          Standaard medisch onderzoek vindt niets. Je longen werken, je hart klopt, je bloed is normaal. Maar de fijnafstemming van je ademhaling is uit balans, en dat veroorzaakt echte, meetbare klachten.
        </p>
        <div class="flex flex-wrap gap-3 relative z-10">
          <a href="/wat-is-het/ademhaling" class="inline-flex items-center gap-1.5 px-5 py-2.5 border border-sage-200 rounded-full text-sm text-sage-400 no-underline bg-white hover:border-sage-300 hover:text-sage-500 transition-all">
            Hoe ademhaling werkt
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/wat-is-het/wat-gaat-er-mis" class="inline-flex items-center gap-1.5 px-5 py-2.5 border border-sage-200 rounded-full text-sm text-sage-400 no-underline bg-white hover:border-sage-300 hover:text-sage-500 transition-all">
            Wat gaat er mis bij CHV?
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Drie lagen -->
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pb-20">
    <div class="max-w-[720px] mx-auto">
      <p class="text-xs font-medium tracking-widest uppercase text-sand-400 mb-4">Hoe deze site werkt</p>
      <p class="text-body text-sand-600 mb-7">
        Elke pagina is opgebouwd in drie lagen, van herkenning tot wetenschappelijke verdieping.
      </p>
      <div class="grid md:grid-cols-3 gap-3 reveal">
        <div class="p-5 rounded-xl bg-sage-50">
          <div class="text-[11px] font-medium uppercase tracking-wider text-sage-400 mb-2">Herkennen</div>
          <p class="text-[13px] leading-snug text-sand-600">Twee zinnen die iedereen begrijpt</p>
        </div>
        <div class="p-5 rounded-xl bg-terra-50">
          <div class="text-[11px] font-medium uppercase tracking-wider text-terra-400 mb-2">Begrijpen</div>
          <p class="text-[13px] leading-snug text-sand-600">Het mechanisme in heldere taal</p>
        </div>
        <div class="p-5 rounded-xl bg-plum-50">
          <div class="text-[11px] font-medium uppercase tracking-wider text-plum-400 mb-2">Verdiepen</div>
          <p class="text-[13px] leading-snug text-sand-600">Papers en bronnen met directe links</p>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="border-t border-sand-200 max-w-[1200px] mx-auto px-6 md:px-12 py-16">
    <div class="max-w-[720px] mx-auto">
      <div class="grid grid-cols-[4px_1fr] gap-8 reveal">
        <div class="bg-gradient-to-b from-sage-300 to-sage-50 rounded-sm"></div>
        <div>
          <h2 class="font-serif text-[22px] font-normal mb-3">Er is iets aan te doen</h2>
          <p class="text-body text-sand-600 mb-6">
            Chronische hyperventilatie is geen gevaarlijke aandoening, maar het heeft een grote impact op het dagelijks leven. Met de juiste aanpak verbetert het. Maar het begint bij begrip.
          </p>
          <a href="/behandeling" class="inline-flex items-center gap-2 px-7 py-3 bg-sage-300 text-white text-sm font-medium rounded-lg no-underline hover:bg-sage-400 transition-colors">
            Bekijk de behandelopties
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

</Base>
