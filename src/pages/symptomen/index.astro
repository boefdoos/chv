---
import Base from '../../layouts/Base.astro';

const symptoms = [
  {
    slug: 'veel-zuchten',
    title: 'Veel zuchten',
    description: 'Frequenter zuchten dan gemiddeld is een van de vroegste signalen van een verstoorde adembalans. De fysiologische verklaring is preciezer dan je zou verwachten.',
  },
  {
    slug: 'gapen',
    title: 'Overmatig gapen',
    description: 'Gapen zonder slaperig te zijn is een onderschat maar herkenbaar signaal. Het deelt zijn mechanisme met frequent zuchten, maar heeft een eigen sociale dimensie.',
  },
];
---

<Base
  title="Herkenning: symptomen van chronische hyperventilatie"
  description="Herken je symptomen en begrijp wat ze fysiologisch betekenen. Per symptoom: de mechanistische verklaring, de link met CHV, en wat het je vertelt."
>
  <main class="max-w-3xl mx-auto px-6 py-16">

    <p class="text-xs font-medium tracking-widest uppercase text-sage-300 mb-3">Herkenning</p>
    <h1 class="font-serif text-h2 text-sand-700 mb-4">Wat vertelt jouw lichaam?</h1>
    <p class="text-body text-sand-500 mb-4 max-w-xl">
      Chronische hyperventilatie heeft een breed spectrum aan symptomen. Sommige, zoals frequent zuchten of overmatig gapen, zijn direct herkenbaar als ademhalingsgerelateerd. Andere, zoals duizeligheid, hartkloppingen of concentratieproblemen, hebben een minder voor de hand liggende verbinding met de ademhaling.
    </p>
    <p class="text-body text-sand-500 mb-12 max-w-xl">
      Per symptoom leggen we de fysiologische keten uit.
    </p>

    <p class="text-xs font-medium tracking-widest uppercase text-sand-400 mb-4">Symptomen onder de loep</p>
    <ul class="space-y-4">
      {symptoms.map(s => (
        <li>
          <a href={`/symptomen/${s.slug}/`} class="group block bg-sage-50 hover:bg-sage-100 border border-sage-200 hover:border-sage-300 rounded-2xl p-8 transition-all no-underline">
            <p class="text-xs font-medium tracking-widest uppercase text-sage-300 mb-2">Symptoom onder de loep</p>
            <div class="flex items-start justify-between gap-6">
              <div>
                <h2 class="font-serif text-[22px] font-normal text-sand-700 group-hover:text-sage-500 transition-colors mb-3">{s.title}</h2>
                <p class="text-[15px] text-sand-500 leading-relaxed">{s.description}</p>
              </div>
              <div class="w-10 h-10 min-w-[40px] rounded-full bg-sage-200 group-hover:bg-sage-300 flex items-center justify-center transition-colors mt-1">
                <svg class="w-4 h-4 text-sage-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

  </main>
</Base>
