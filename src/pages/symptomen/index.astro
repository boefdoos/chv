---
import Base from '../../layouts/Base.astro';

const symptoms = [
  {
    slug: 'veel-zuchten',
    title: 'Veel zuchten',
    description: 'Een overactief resetmechanisme van de longen dat zichzelf in stand houdt.',
  },
  {
    slug: 'gapen',
    title: 'Overmatig gapen',
    description: 'Hetzelfde mechanisme als zuchten, met een eigen sociale dimensie.',
  },
  {
    slug: 'luchthonger',
    title: 'Niet diep genoeg kunnen ademen',
    description: 'Geen mechanisch probleem. Een zintuiglijk fenomeen met een naam: luchthonger.',
  },
  {
    slug: 'hartkloppingen',
    title: 'Hartkloppingen',
    description: 'Drie fysiologische mechanismen verklaren hartkloppingen zonder cardiale oorzaak.',
  },
];
---

<Base
  title="Herkenning: symptomen van chronische hyperventilatie"
  description="Herken je symptomen en begrijp wat ze fysiologisch betekenen. Per symptoom: de mechanistische verklaring, de link met CHV, en wat het je vertelt."
>

  <!-- Breadcrumb -->
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pt-4 text-[13px] text-sand-500">
    <a href="/" class="no-underline text-sand-500 hover:text-sage-300">Home</a>
    <span class="mx-2 opacity-40">/</span>
    Herkenning
  </div>

  <!-- Titel -->
  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pt-10 pb-5">
    <h1 class="font-serif text-hero font-light max-w-[640px]">Wat vertelt jouw lichaam?</h1>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 md:px-12 pt-4 pb-20">
    <div class="max-w-[720px] mx-auto">

      <!-- Hero kader -->
      <div class="bg-sage-50 rounded-2xl p-8 md:p-10 mb-12 relative overflow-hidden reveal">
        <div class="absolute -right-10 -top-10 w-[200px] h-[200px] rounded-full bg-sage-300/[0.08] animate-breathe"></div>
        <p class="font-serif text-[20px] leading-[1.7] text-sage-500 relative z-10">
          Chronische hyperventilatie herkent men zelden meteen aan de ademhaling. De signalen zijn er wel, maar ze komen in vele gedaanten. Per symptoom leggen we de <strong>fysiologische keten</strong> uit.
        </p>
      </div>

      <!-- Intro -->
      <p class="text-body text-sand-600 mb-4 max-w-xl">
        Sommige symptomen, zoals frequent zuchten of overmatig gapen, zijn direct herkenbaar als ademhalingsgerelateerd. Andere, zoals duizeligheid, hartkloppingen of concentratieproblemen, hebben een minder voor de hand liggende verbinding met de ademhaling.
      </p>
      <p class="text-body text-sand-600 mb-12 max-w-xl">
        Elk symptoom in deze gids wordt mechanistisch uitgelegd: wat er fysiologisch speelt, waarom het bij chronische hyperventilatie zo hardnekkig aanwezig is, en wat het je vertelt.
      </p>

      <!-- Symptomenraster -->
      <p class="text-xs font-medium tracking-widest uppercase text-sand-400 mb-4">Symptomen onder de loep</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {symptoms.map(s => (
          <li>
            <a href={`/symptomen/${s.slug}/`} class="group flex flex-col justify-between h-full bg-sage-50 hover:bg-sage-100 border border-sage-200 hover:border-sage-300 rounded-2xl p-6 transition-all no-underline min-h-[160px]">
              <div>
                <p class="text-xs font-medium tracking-widest uppercase text-sage-300 mb-2">Symptoom</p>
                <h2 class="font-serif text-[18px] font-normal text-sand-700 group-hover:text-sage-500 transition-colors mb-3 leading-snug">{s.title}</h2>
                <p class="text-[13px] text-sand-500 leading-relaxed">{s.description}</p>
              </div>
              <div class="flex justify-end mt-4">
                <div class="w-8 h-8 rounded-full bg-sage-200 group-hover:bg-sage-300 flex items-center justify-center transition-colors">
                  <svg class="w-3.5 h-3.5 text-sage-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                  </svg>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </div>

</Base>
